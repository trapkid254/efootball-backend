# Server Configuration
NODE_ENV=production
PORT=10000

# Database - Use MongoDB Atlas for production
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tona-kikwetu?retryWrites=true&w=majority

# JWT - Generate a strong secret
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production

# Frontend URL - Your Netlify URL
FRONTEND_URL=https://tonakikwetu.netlify.app

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# M-Pesa Daraja API
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_BUSINESS_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=your-callback-url

# WhatsApp API (Future)
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id